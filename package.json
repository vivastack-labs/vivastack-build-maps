{
  "name": "vivastack-build-maps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "pnpm lint:eslint && pnpm lint:prettier && pnpm lint:md && pnpm lint:yaml",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check --no-error-on-unmatched-pattern \"{app,src,tests,scripts,geo}/**/*.{ts,tsx,js,mjs,cjs,css,json}\" \"*.{ts,mjs}\" package.json tsconfig.json",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#test-results\" \"#playwright-report\" \"#coverage\" \"#out\"",
    "lint:yaml": "yamllint . && yamllint -c content/.yamllint content/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "browserslist": [
    "last 2 Chrome major versions",
    "last 2 Edge major versions",
    "last 2 Firefox major versions",
    "last 2 Safari major versions",
    "last 2 iOS major versions",
    "last 1 ChromeAndroid versions"
  ],
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "31.0.0",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3",
    "vitest": "5.1.0",
    "wrangler": "4.160.0"
  }
}
