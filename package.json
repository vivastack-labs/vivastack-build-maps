{
  "name": "vivastack-build-maps",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "next dev",
    "build": "BUILD_TARGET=production next build && node scripts/postbuild.ts",
    "build:preview": "BUILD_TARGET=preview next build && node scripts/postbuild.ts",
    "lint": "pnpm lint:eslint && pnpm lint:prettier && pnpm lint:md && pnpm lint:yaml",
    "lint:eslint": "eslint .",
    "lint:prettier": "prettier --check --no-error-on-unmatched-pattern \"{app,src,tests,scripts,geo}/**/*.{ts,tsx,js,mjs,cjs,css,json}\" \"*.{ts,mjs}\" package.json tsconfig.json wrangler.jsonc",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\" \"#test-results\" \"#playwright-report\" \"#test-results-preview\" \"#playwright-report-preview\" \"#coverage\" \"#out\" \"#dist\" \"#.wrangler\"",
    "lint:yaml": "yamllint . && yamllint -c content/.yamllint content/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:preview": "playwright test -c playwright.preview.config.ts",
    "screenshots": "node scripts/pr-screenshots.ts",
    "geo:build": "node geo/scripts/build-geo.ts",
    "content:types": "node scripts/content-types.ts",
    "content:validate": "node scripts/validate-content.ts",
    "content:furigana": "node scripts/furigana.ts",
    "size": "node scripts/measure-size.ts",
    "lhci": "lhci collect --config=lighthouserc.yml && lhci collect --config=lighthouserc.tablet.yml --additive --collect.settings.formFactor=mobile --collect.settings.screenEmulation.mobile --collect.settings.screenEmulation.width=800 --collect.settings.screenEmulation.height=1280 --collect.settings.screenEmulation.deviceScaleFactor=2 && lhci upload --config=lighthouserc.yml && lhci assert --config=lighthouserc.yml"
  },
  "browserslist": [
    "last 2 Chrome major versions",
    "last 2 Edge major versions",
    "last 2 Firefox major versions",
    "last 2 Safari major versions",
    "last 2 iOS major versions",
    "last 1 ChromeAndroid versions"
  ],
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "dependencies": {
    "ajv": "8.20.0",
    "d3-geo": "3.1.2",
    "d3-selection": "3.0.1",
    "d3-transition": "3.0.2",
    "d3-zoom": "3.0.1",
    "next": "16.4.6",
    "polylabel": "2.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "topojson-client": "3.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/d3-geo": "3.1.1",
    "@types/d3-selection": "3.0.12",
    "@types/d3-transition": "3.0.9",
    "@types/d3-zoom": "3.0.9",
    "@types/geojson": "7946.0.16",
    "@types/node": "^26.6.6",
    "@types/polylabel": "^2.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "3.1.5",
    "@types/topojson-specification": "1.0.5",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "65.4.4",
    "fast-check": "4.10.2",
    "fflate": "0.8.3",
    "jsdom": "31.0.0",
    "json-schema-to-typescript": "16.0.0",
    "lindera-wasm-nodejs-ipadic": "2.0.0",
    "mapshaper": "0.7.101",
    "markdownlint-cli2": "^0.24.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.5",
    "typescript": "~6.0.3",
    "vitest": "5.1.0",
    "workbox-build": "7.4.1",
    "wrangler": "4.160.0"
  }
}
