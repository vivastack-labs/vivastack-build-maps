lib/
lib64/
# Keep JavaScript library files in plugins
!plugins/*/scripts/lib/
!plugins/*/scripts/lib/**
# Keep library files in .claude directories
!.claude/*/lib
# Keep app library code (src/lib/) and its tests despite the Python lib/ rule above
!src/lib/
!tests/unit/lib/
# Keep geo build library code (geo/scripts/lib/) and its tests for the same reason
!geo/scripts/lib/
!tests/unit/geo/scripts/lib/
# Keep content-tool library code (scripts/lib/) for the same reason
!scripts/lib/
