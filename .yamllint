# .yamllint
extends: default

# Generated files and dependencies (not written by hand)
ignore: |
  node_modules/
  .next/
  out/
  dist/
  coverage/
  pnpm-lock.yaml

rules:
  line-length:
    max: 120
    # content/ is linted with content/.yamllint (looser limit for furigana text)
    ignore: |
      content/
  indentation:
    spaces: 2
  trailing-spaces: disable
